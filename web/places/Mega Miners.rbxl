			<Item class="Script" referent="RBX470">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">sp = script.Parent
Background = sp.Background
Division = script.Division
ExtraX = 125/2
ExtraZ = 125/2
Players = game:GetService(&quot;Players&quot;)
on = true 
get = Background:getChildren()
coos = {}
for i=1, #get do
if get[i].Name ~= &quot;Self&quot; then
table.insert(coos,get[i])
end
end
self = Background.Self

while on do
wait(.1)
pcall(function()
getPlayers = Players:getChildren()
count = Players.NumPlayers
t = 1
char1 = script.Parent.Parent.Parent.Character
--self.Position = UDim2.new(0,	(char.Torso.Position.X/Division.Value)+ExtraX+82.6,		0,		(char.Torso.Position.Z/Division.Value)+ExtraZ-132)
self.Text = char1.Name
for i=1, #getPlayers do
if getPlayers[i].Name ~= script.Parent.Parent.Parent.Name then
--print(&quot;e&quot;)
char = getPlayers[i].Character
coos[t].Visible = true
coos[t].Text = char.Name
coos[t].Position = UDim2.new(0,	((char1.Torso.Position.X-char.Torso.Position.X)+ExtraX+119)/Division.Value+52,		0,		((char1.Torso.Position.Z-char.Torso.Position.Z)+ExtraZ-36)/Division.Value+114)
if coos[t].Position.X.Offset &lt; 0 or coos[t].Position.X.Offset &gt; 250 or  coos[t].Position.Y.Offset &gt; 250 or  coos[t].Position.Y.Offset &lt; 0 then
coos[t].Visible = false
end

t = t + 1
end
end
--print(t)
for i=t, #coos do

coos[i].Visible = false

end

end) 



end
</ProtectedString>
					<bool name="archivable">true</bool>
