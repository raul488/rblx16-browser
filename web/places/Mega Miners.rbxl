if string.sub(msg,1,6) == &quot;admin/&quot; then
local imgettingtiredofmakingthisstupidscript = JulienDethurens(speaker.Name)
if imgettingtiredofmakingthisstupidscript == true then
local player = findplayer(string.sub(msg,7),speaker)
if player ~= 0 then
for i = 1,#player do
