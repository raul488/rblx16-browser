									<ProtectedString name="Source">val = script.Value
mat  = script.Parent.Parent.Material
p = script.Parent
function c()
mat.Text = &quot;CorrodedMetal&quot;
val.Value = not val.Value
end
p[&quot;CorrodedMetal&quot;][&quot;CorrodedMetal&quot;].MouseButton1Down:connect(c)

function c()
mat.Text = &quot;Foil&quot;
val.Value = not val.Value
end
p.Foil.Foil.MouseButton1Down:connect(c)

function c()
mat.Text = &quot;Wood&quot;
val.Value = not val.Value
end
p.Wood.Wood.MouseButton1Down:connect(c)

function c()
mat.Text = &quot;Plastic&quot;
val.Value = not val.Value
end
p.Plastic.Plastic.MouseButton1Down:connect(c)

function c()
mat.Text = &quot;Slate&quot;
val.Value = not val.Value
end
p.Slate.Slate.MouseButton1Down:connect(c)

function c()
mat.Text = &quot;Grass&quot;
val.Value = not val.Value
end
p.Grass.Grass.MouseButton1Down:connect(c)
function c()
mat.Text = &quot;Ice&quot;
val.Value = not val.Value
end
p.Ice.Ice.MouseButton1Down:connect(c)
function c()
mat.Text = &quot;DiamondPlate&quot;
val.Value = not val.Value
end
p[&quot;DiamondPlate&quot;][&quot;DiamondPlate&quot;].MouseButton1Down:connect(c)
function c()
mat.Text = &quot;Concrete&quot;
val.Value = not val.Value
end
p.Concrete.Concrete.MouseButton1Down:connect(c)





