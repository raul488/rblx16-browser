		</Item>
		<Item class="HopperBin" referent="RBX174">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Dig</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX175">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DigScript</string>
					<ProtectedString name="Source">mat = script.ScreenGui --[[IMPORTANT : The gui is invisible, right now. ]]
bounce = false
Vectors = {Vector3.new(0,6,0),	Vector3.new(0,0,6),		Vector3.new(6,0,0),		Vector3.new(0,-6,0),		Vector3.new(-6,0,0),		Vector3.new(0,0,-6)	}

function onButton1Down(mouse)
if bounce == true then return end
pcall(function()
bounce = true
Target = mouse.Target
Hit = mouse.Hit
TargetCFrame = Target.CFrame
TargetPosition = Target.Position
if Target.Name == &quot;Dirt&quot; then

Target:remove()
for i=1, #Vectors do
getVals = game.Lighting.Values:getChildren()
Tep = true
for t=1, #getVals do
if getVals[t].Value == Vector3.new(0,0,0) + TargetPosition + Vectors[i] then
Tep = false
break
end
end

if Tep then
--print(Target.CFrame)
Val = Instance.new(&quot;Vector3Value&quot;) 
Val.Value = Vector3.new(0,0,0) + TargetPosition + Vectors[i]
Val.Parent = game.Lighting.Values

Part = Instance.new(&quot;Part&quot;)
Part.BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
Part.Anchored = true
Part.Name = &quot;Dirt&quot;
Part.Material = mat.Material.Material.Text
Part.formFactor = &quot;Symmetric&quot;
Part.Size = Vector3.new(6,6,6)
Part.CFrame = TargetCFrame + Vectors[i]
Part.TopSurface = &quot;Smooth&quot;
Part.BottomSurface = &quot;Smooth&quot;
Part.Parent = workspace
end 
end


end


end)


bounce = false
end

function onSelected(mouse)
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mat.Parent = script.Parent.Parent.Parent.PlayerGui
end

script.Parent.Selected:connect(onSelected)



function offSelected(mouse)

mat.Parent = script
end

script.Parent.Deselected:connect(offSelected)


</ProtectedString>
