				<ProtectedString name="Source">badgeId=54632270 --Change The Badge ID To The Value Of A IntValue That Is In The Badge Model--

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;Planet3arth&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;Planet3arth&quot; then --Change &quot;Planet3arth&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;Planet3arth&quot;)~=nil then --Again Change &quot;Planet3arth&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

