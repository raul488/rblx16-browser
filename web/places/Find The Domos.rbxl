function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;GooshieBaBa&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;GooshieBaBa&quot; then --Change &quot;Planet3arth&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;GooshieBaBa&quot;)~=nil then --Again Change &quot;Planet3arth&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
