					<ProtectedString name="Source">model=script.Parent.Parent
tool=script.Parent
if model.className == &quot;Model&quot; then
tool.Parent=model.Parent
tool:clone().Parent=tool.Parent.Parent.StarterGear
model:remove()
end</ProtectedString>
