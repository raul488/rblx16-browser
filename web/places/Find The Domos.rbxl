			<Item class="LocalScript" referent="RBX5613">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Admins</string>
					<ProtectedString name="Source">plr = script.Parent.Parent.Parent
admins = {&quot;Player&quot;, &quot;Planet3arth&quot;, &quot;pieguy100000&quot;, &quot;Pinbat&quot;}

d = false

for i = 1, #admins do
if plr.Name == admins[i] then
d = true
break
end
end

if not d then
script.Parent:remove()
end
</ProtectedString>
				</Properties>
