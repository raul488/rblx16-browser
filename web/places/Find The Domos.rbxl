		<Item class="Script" referent="RBX559">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">6hourBadge</string>
				<ProtectedString name="Source">BadgetId = 54993525 --Replace with badge ID

game.Players.PlayerAdded:connect(function(p) 
wait(21600) -- Replace with number of seconds until badge is awarded  
b = game:GetService(&quot;BadgeService&quot;) 
b:AwardBadge(p.userId,BadgetId) 
end)
-- Time badge by yi18</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX560">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">BadgeId = 54954573
game.Players.PlayerAdded:connect(function(p)
if p.Name == &quot;61352151511&quot; then
p.CharacterAdded:connect(function(char)
c = char:GetChildren()
for i = 1, #c do
if c[i].ClassName == &quot;Part&quot; then
c[i].Touched:connect(function(hit)
plr = game.Players:GetPlayerFromCharacter(hit.Parent)
if plr then
game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId, BadgeId)
end
end)
end
wait()
end
end)
end
end)
</ProtectedString>
			</Properties>
		</Item>
