								<ProtectedString name="Source">function onButtonClicked()
p1 = script.Parent.Parent.From.Text
p2 = script.Parent.Parent.To.Text
pp1 = game.Workspace:findFirstChild(p1)
pp2 = game.Workspace:findFirstChild(p2)
pp1.Torso.CFrame = pp2.Torso.CFrame
wait(.01)
end
script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
