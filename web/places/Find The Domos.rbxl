				<Item class="Script" referent="RBX1356">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Gobble = script.Parent.Sound
local Turkey = script.Parent.Parent
Enabled = true 

function onTouched(hit)
if (Enabled == true) then 
Enabled = false 
Gobble:Play()
Turkey.Name = &quot;Gobble gobble gobble!&quot;
wait(1.5)
Turkey.Name = &quot;Penguin&quot;
Enabled = true 
end 
end 

script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
