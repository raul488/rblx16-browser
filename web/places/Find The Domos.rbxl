		<Item class="Script" referent="RBX3685">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">60MinuteBadge</string>
				<ProtectedString name="Source">BadgetId = 54992177 --Replace with badge ID

game.Players.PlayerAdded:connect(function(p) 
wait(1800) -- Replace with number of seconds until badge is awarded  
b = game:GetService(&quot;BadgeService&quot;) 
b:AwardBadge(p.userId,BadgetId) 
end)
-- Time badge by yi18</ProtectedString>
			</Properties>
