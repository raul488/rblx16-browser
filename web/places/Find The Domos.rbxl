							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Messages = {
&quot;Latest Update: Sun Domo added!&quot;,
&quot;No showing where badges are! It ruins the fun!&quot;,
&quot; with points, you can purchase things in the shop, by clicking the shop gui! add more points to gain cooler prizes!&quot;,
}

while true do
&#9;for i = 1, #Messages do
&#9;&#9;local text = Messages[i]
&#9;&#9;for i1 = 1, 50 do
&#9;&#9;&#9;script.Parent.Text = string.sub(text, 1, i1)
&#9;&#9;&#9;wait(.1)
&#9;&#9;end
&#9;&#9;for i = 1, string.len(text) + 51 do
&#9;&#9;&#9;script.Parent.Text = string.sub(text,i + 3, i + 53)
&#9;&#9;&#9;wait(.1)
&#9;&#9;end
&#9;&#9;script.Parent.Text = &quot;&quot;
&#9;&#9;wait(1)
&#9;end
end
