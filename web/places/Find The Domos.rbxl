				<string name="Name">Day/Night Cycle</string>
				<ProtectedString name="Source">----------------------------------------------ROBLOX MULTI-NATIONAL: Modified Time of Day script-------------------------------------------
speed = 3
-----------^-------------------Change the number above for the speed(1-6; 1= Slow, 6 = Fast)----------------------------

--Do not attempt to edit
sec = 0
min = 0
hour = 0
while true do 
game.Lighting.TimeOfDay = &quot;&quot;..hour..&quot;:&quot;..min..&quot;:&quot;..sec..&quot;&quot;
sec = sec + (5*speed)
if sec &gt;= 60 then
sec = 0
min = min + 1
end
if min &gt;= 60 then
min = 0
hour = hour + 1
end
if hour &gt;= 24 then
hour = 0
end
wait(0.03)
end
</ProtectedString>
