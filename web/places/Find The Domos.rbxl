		<Item class="Script" referent="RBX75">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regenerate</string>
				<ProtectedString name="Source">---SquallLeonhartX

model = game.Workspace.Dragon --Change this to the model your putting this in or it won&apos;t work.

backup = model:clone()

while true do
&#9;wait(60) --- (Opitional) Change time between regerations.


&#9;model:remove()



&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()

end
</ProtectedString>
			</Properties>
