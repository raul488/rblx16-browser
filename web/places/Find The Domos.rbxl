		<Item class="Script" referent="RBX3710">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">night time script</string>
				<ProtectedString name="Source">BadgeId = 55103224
BeginningOfNight = &quot;20:00:00&quot;
EndingOfNight = &quot;6:00:00&quot;

deb = false
script.Parent.Touched:connect(function(hit)
if deb == false then
deb = true
plr = game.Players:GetPlayerFromCharacter(hit.Parent)
if plr then
if game.Lighting.TimeOfDay &gt;= (BeginningOfNight) and game.Lighting.TimeOfDay &lt;= (EndingOfNight) then
game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId, BadgeId)
end
end
wait(1)
deb = false
end
end)

game.Lighting.Changed:connect(function()
if game.Lighting.TimeOfDay &gt;= (BeginningOfNight) and game.Lighting.TimeOfDay &lt;= (EndingOfNight) then
script.Parent.CanCollide = true
script.Parent.Transparency = 0
script.Parent.Decal.Transparency = 0
else
script.Parent.CanCollide = false
script.Parent.Transparency = 1
script.Parent.Decal.Transparency = 1 -- Makes decal transparent
end
end)</ProtectedString>
			</Properties>
