								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onButtonClicked()
p1 = script.Parent.Parent.BrickSize1.Text
p2 = script.Parent.Parent.BrickSize2.Text
p3 = script.Parent.Parent.BrickSize3.Text
pp = script.Parent.Parent.Player.Text
ppp = game.Workspace:findFirstChild(pp)
local a = Instance.new(&quot;Part&quot;)
a.Size = Vector3.new(p1,p2,p3)
a.Position = ppp.Head.Position + Vector3.new(0,3,0)
