					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">-- My first non free modeled script!
door = script.Parent --Interacts with the scripts parent

while true do --critical function, keeps the script running forever remove this if you only want the script to work once
door.Transparency = 1 --sets properties
door.CanCollide = false --sets properties
wait(15) --waits the amount of time
door.Transparency = 0 --sets properties
door.CanCollide = true --sets properties
wait(305) --waits amount of time
end --well its certainly not an elephant
</ProtectedString>
