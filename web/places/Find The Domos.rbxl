					<Item class="Script" referent="RBX5528">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function GetTime()
T = math.floor(game.Workspace.DistributedGameTime)
H = math.floor(T/3600)
T2 = T - (H * 3600)
M = math.floor(T2/60)
S = T2 - (M * 60)
msg = &quot;&quot;
if H == 0 then
msg = msg
elseif H == 1 then
msg = msg..H..&quot; Hour &quot;
else
msg = msg..H..&quot; Hours &quot;
end
if M == 0 then
msg = msg
elseif M == 1 then
msg = msg..M..&quot; Minute &quot;
else
msg = msg..M..&quot; Minutes &quot;
end
if S == 0 then
msg = msg
elseif S == 1 then
msg = msg..S..&quot; Second&quot;
else
msg = msg..S..&quot; Seconds&quot;
end
script.Parent.Text = &quot;Server Time: &quot;..msg
end

while true do
GetTime()
wait(.5)
end
</ProtectedString>
						</Properties>
					</Item>
