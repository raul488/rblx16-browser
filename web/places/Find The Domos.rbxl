								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function()
per = script.Parent.Parent.Player.Text
pers = game.Workspace:findFirstChild(per)
hopone = Instance.new(&quot;HopperBin&quot;)
hopone.Name = &quot;Copy&quot;
hopone.BinType = &quot;Clone&quot;
hoptwo = Instance.new(&quot;HopperBin&quot;)
hoptwo.Name = &quot;Delete&quot;
hoptwo.BinType = &quot;Hammer&quot;
hopthree = Instance.new(&quot;HopperBin&quot;)
hopthree.Name &quot;Drag&quot;
hopthree.BinType &quot;GameTool&quot;
hopone.Parent = pers.Backpack
hoptwo.Parent = pers.Backpack
hopthree.Parent = pers.Backpack
end)






</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX5618">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.MouseButton1Down:connect(function()
person = script.Parent.Parent.Player.Text
pers = game.Players:findFirstChild(person)
hop = Instance.new(&quot;HopperBin&quot;)
hop.Name = &quot;Drag&quot;
hop.BinType = &quot;GameTool&quot;
hopp = Instance.new(&quot;HopperBin&quot;)
hopp.Name = &quot;Delete&quot;
hopp.BinType = &quot;Hammer&quot;
hoppe = Instance.new(&quot;HopperBin&quot;)
hoppe.Name = &quot;Clone&quot;
hoppe.BinType = &quot;Clone&quot;
hop.Parent = pers.Backpack
hopp.Parent = pers.Backpack
hoppe.Parent = pers.Backpack
end)</ProtectedString>
