							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Items = {&quot;TTB&quot;, &quot;TTC&quot;, &quot;TTD&quot;, &quot;TTL&quot;, &quot;TTV&quot;, &quot;Information&quot;}
debounce = false
TT = script.Parent.Parent.Parent.TeleportTo
script.Parent.MouseButton1Click:connect(function()
if debounce == false then
debounce = true
if TT.Visible == false then
TT.Visible = true
TT:TweenSizeAndPosition(UDim2.new(0, 200, 0, 200), UDim2.new(0.5, -240, 0.5, -100))
script.Parent.Parent:TweenPosition(UDim2.new(0.5, -40, 0.5, -100))
wait(1)
for i = 1, #Items do
TT:FindFirstChild(Items[i]).Visible = true
for tr = 1, 0, -0.1 do
TT:FindFirstChild(Items[i]).TextTransparency = tr
wait()
end
end
TT.PlaceImage.Visible = true
TT.PlaceImage2.Visible = true
else
TT.PlaceImage.Visible = false
TT.PlaceImage2.Visible = false
for i = #Items, 1, -1 do
for tr = 0, 1, 0.1 do
TT:FindFirstChild(Items[i]).TextTransparency = tr
wait()
end
TT:FindFirstChild(Items[i]).Visible = false
end
script.Parent.Parent:TweenPosition(UDim2.new(0.5, -140, 0.5, -100))
TT:TweenSizeAndPosition(UDim2.new(0, 0, 0, 200), UDim2.new(0.5, -140, 0.5, -100))
wait(1)
TT.Visible = false
end
debounce = false
end
end)</ProtectedString>
