&#9;footerPanel.BackgroundTransparency = 1
&#9;footerPanel.BackgroundColor3 = frameColor
&#9;footerPanel.Parent = insertTab
&#9;
&#9;local rolloverText = Instance.new(&quot;TextLabel&quot;)
