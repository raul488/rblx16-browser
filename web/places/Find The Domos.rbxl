			<Item class="Script" referent="RBX2997">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><url>http://www.roblox.com/asset/?id=13326026</url></Content>
					<string name="Name">BadgeAwarderScript</string>
					<ProtectedString name="Source">print(&quot;Badge Awarder Loaded. BadgeID: &quot; .. script.Parent.BadgeID.Value)



-- ROBLOX scripter hackers, see what you can do with this:
-- game:GetService(&quot;BadgeService&quot;):UserHasBadge(userid, badgeid)


function OnTouch(part)
&#9;if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
&#9;&#9;local p = game.Players:GetPlayerFromCharacter(part.Parent)
&#9;&#9;if (p ~= nil) then
&#9;&#9;&#9;print(&quot;Awarding BadgeID: &quot; ..script.Parent.BadgeID.Value .. &quot; to UserID: &quot; .. p.userId)
&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;b:AwardBadge(p.userId, script.Parent.BadgeID.Value)
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(OnTouch)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="IntValue" referent="RBX2998">
				<Properties>
					<string name="Name">BadgeID</string>
					<int name="Value">55103224</int>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2999">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">night time script</string>
					<ProtectedString name="Source">BadgeId = 55103224
BeginningOfNight = &quot;20:00:00&quot;
EndingOfNight = &quot;6:00:00&quot;

deb = false
script.Parent.Touched:connect(function(hit)
if deb == false then
deb = true
plr = game.Players:GetPlayerFromCharacter(hit.Parent)
if plr then
if game.Lighting.TimeOfDay &gt;= (BeginningOfNight) and game.Lighting.TimeOfDay &lt;= (EndingOfNight) then
game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId, BadgeId)
end
end
wait(1)
deb = false
end
end)

game.Lighting.Changed:connect(function()
if game.Lighting.TimeOfDay &gt;= (BeginningOfNight) and game.Lighting.TimeOfDay &lt;= (EndingOfNight) then
script.Parent.CanCollide = true
script.Parent.Transparency = 0
script.Parent.Decal.Transparency = 0
else
script.Parent.CanCollide = false
script.Parent.Transparency = 1
script.Parent.Decal.Transparency = 1 -- Makes decal transparent
end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
