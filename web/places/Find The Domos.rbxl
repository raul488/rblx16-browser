					<ProtectedString name="Source">enabled = true
function onTouched(hit)
&#9;if not enabled then return end
&#9;enabled = false 
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;h.Sit = true
