		<Item class="Script" referent="RBX3437">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RemoveSnaps</string>
				<ProtectedString name="Source">p= game.Workspace:GetChildren()&#9;&#9;&#9;
for i= 1, #p do&#9;&#9;&#9;&#9;
if p[i].className == &quot;Part&quot; then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
elseif p[i].className == &quot;Model&quot; then
pp=p[i]:GetChildren()
for i=1, #pp do
if pp[i].className == &quot;Part&quot; then
if pp[i].Anchored == true then
pp[i]:BreakJoints()
end
end
end
end
end</ProtectedString>
			</Properties>
