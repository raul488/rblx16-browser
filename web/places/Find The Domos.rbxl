							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function()
plr = script.Parent.Parent.Parent.Parent.Parent
char = plr.Character
char:FindFirstChild(&quot;Shirt&quot;):Remove()
char:FindFirstChild(&quot;Pants&quot;):Remove()
char:FindFirstChild(&quot;Left Arm&quot;):Remove()
char:FindFirstChild(&quot;Right Arm&quot;):Remove()
char:FindFirstChild(&quot;Left Leg&quot;):Remove()
char:FindFirstChild(&quot;Right Leg&quot;):Remove()
char:FindFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(&quot;Reddish brown&quot;)
char:FindFirstChild(&quot;Torso&quot;).Material = &quot;Slate&quot;
char:FindFirstChild(&quot;Torso&quot;).TopSurface = &quot;Smooth&quot;
char:FindFirstChild(&quot;Torso&quot;).BottomSurface = &quot;Smooth&quot;
char:FindFirstChild(&quot;Torso&quot;).LeftSurface = &quot;Smooth&quot;
char:FindFirstChild(&quot;Torso&quot;).RightSurface = &quot;Smooth&quot;
char.Head.Transparency = 1
char.Head.face.Transparency = 1
c = char:GetChildren()
for i = 1, #c do
if c[i].ClassName == &quot;CharacterMesh&quot; or c[i].ClassName == &quot;Hat&quot; or c[i].ClassName == &quot;ShirtGraphic&quot; then
c[i]:Remove()
end
wait()
end
Instance.new(&quot;Texture&quot;, char.Torso).Texture = &quot;http://www.roblox.com/asset/?id=6726097&quot;
Instance.new(&quot;BoolValue&quot;, char).Name = &quot;IsDomo&quot;
end)</ProtectedString>
