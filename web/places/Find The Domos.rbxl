function ClearImages()
for i = 1, 10 do
&#9;script.Parent[&quot;ImageLabel&quot;..i].Image = &quot;&quot;
&#9;script.Parent[&quot;TextLabel&quot;..i].Text = &quot;&quot;
&#9;script.Parent[&quot;ImageLabel&quot;..i].Visible = false
&#9;script.Parent[&quot;TextLabel&quot;..i].Visible = false
&#9;wait()
end
end

script.Parent.Next.MouseButton1Click:connect(function()
if script.Parent.Current.Value &lt;= (BadgeAmount - 1) then
script.Parent.Current.Value = script.Parent.Current.Value + 10
ClearImages()
for i = 1, 10 do
script.Parent[&quot;TextLabel&quot;..i].Text = (Domo[script.Parent.Current.Value - (11 - i)])..&quot; Domo&quot;
script.Parent[&quot;ImageLabel&quot;..i].Image = &quot;http://www.roblox.com/Thumbs/Asset.ashx?x=100&amp;y=100&amp;Format=Png&amp;assetId=&quot;..Images[script.Parent.Current.Value - (11 - i)]
script.Parent[&quot;ImageLabel&quot;..i].Visible = true
script.Parent[&quot;TextLabel&quot;..i].Visible = true
if b:UserHasBadge(user.userId, Images[script.Parent.Current.Value - (11 - i)]) then
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604882&quot;
else
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604833&quot;
end
wait()
end
else
script.Parent.Current.Value = 1
ClearImages()
for i = 1, 10 do
script.Parent[&quot;TextLabel&quot;..i].Text = (Domo[script.Parent.Current.Value - (11 - i)])..&quot; Domo&quot;
script.Parent[&quot;ImageLabel&quot;..i].Image = &quot;http://www.roblox.com/Thumbs/Asset.ashx?x=100&amp;y=100&amp;Format=Png&amp;assetId=&quot;..Images[script.Parent.Current.Value - (11 - i)]
script.Parent[&quot;ImageLabel&quot;..i].Visible = true
script.Parent[&quot;TextLabel&quot;..i].Visible = true
if b:UserHasBadge(user.userId, Images[script.Parent.Current.Value - (11 - i)]) then
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604882&quot;
else
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604833&quot;
end
wait()
end
end
end)

script.Parent.Prev.MouseButton1Click:connect(function()
if script.Parent.Current.Value &gt;= 10 then
script.Parent.Current.Value = script.Parent.Current.Value - 10
ClearImages()
for i = 1, 10 do
script.Parent[&quot;TextLabel&quot;..i].Text = (Domo[script.Parent.Current.Value - (11 - i)])..&quot; Domo&quot;
script.Parent[&quot;ImageLabel&quot;..i].Image = &quot;http://www.roblox.com/Thumbs/Asset.ashx?x=100&amp;y=100&amp;Format=Png&amp;assetId=&quot;..Images[script.Parent.Current.Value - (11 - i)]
script.Parent[&quot;ImageLabel&quot;..i].Visible = true
script.Parent[&quot;TextLabel&quot;..i].Visible = true
if b:UserHasBadge(user.userId, Images[script.Parent.Current.Value - (11 - i)]) then
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604882&quot;
else
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604833&quot;
end
wait()
end
else
script.Parent.Current.Value = BadgeAmount + 1
ClearImages()
for i = 1, 10 do
script.Parent[&quot;TextLabel&quot;..i].Text = (Domo[script.Parent.Current.Value - (11 - i)])..&quot; Domo&quot;
script.Parent[&quot;ImageLabel&quot;..i].Image = &quot;http://www.roblox.com/Thumbs/Asset.ashx?x=100&amp;y=100&amp;Format=Png&amp;assetId=&quot;..Images[script.Parent.Current.Value - (11 - i)]
script.Parent[&quot;ImageLabel&quot;..i].Visible = true
script.Parent[&quot;TextLabel&quot;..i].Visible = true
if b:UserHasBadge(user.userId, Images[script.Parent.Current.Value - (11 - i)]) then
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604882&quot;
else
script.Parent[&quot;ImageLabel&quot;..i].Status.Image = &quot;http://www.roblox.com/asset/?id=47604833&quot;
end
wait()
end
end
end)</ProtectedString>
