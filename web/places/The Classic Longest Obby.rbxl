								<string name="Name">Script</string>
								<ProtectedString name="Source">local LA = script[&quot;Spaceman Left Arm&quot;]:clone()
local LL = script[&quot;Spaceman Left Leg&quot;]:clone()
local RA = script[&quot;Spaceman Right Arm&quot;]:clone()
local RL = script[&quot;Spaceman Right Leg&quot;]:clone()
local T = script[&quot;Spaceman Torso&quot;]:clone()

function onTouch(hit)

	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
		LA.Parent = hit.Parent
		LL.Parent = hit.Parent
		RA.Parent = hit.Parent
		RL.Parent = hit.Parent
		T.Parent = hit.Parent
		wait(0.01)
		
	end
end 

script.Parent.Touched:connect(onTouch)</ProtectedString>
