								<string name="Name">Script</string>
								<ProtectedString name="Source">local LA = script[&quot;LA&quot;]:clone()
local LL = script[&quot;LL&quot;]:clone()
local RA = script[&quot;RA&quot;]:clone()
local RL = script[&quot;RL&quot;]:clone()
local T = script[&quot;T&quot;]:clone()

function onTouch(hit)

	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
		LA.Parent = hit.Parent
		LL.Parent = hit.Parent
		RA.Parent = hit.Parent
		RL.Parent = hit.Parent
		T.Parent = hit.Parent
		wait(0,01)
		
	end
end 

