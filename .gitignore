# --- Vendored 2016 engine source (read-only reference, ~3 GB) -----------------
roblox-2016-source-code-master/

# --- Build output -------------------------------------------------------------
port/out/
port/out/**/*.o
*.o
*.a

# WebAssembly bundle and preloaded content pack (regenerated by link.py)
web/js/rblx2016.js
web/js/rblx2016.wasm
web/js/rblx2016.data
web/js/*.map

# Generated shader packs (regenerated by build_shaders.py)
web/shaders/

# Generated case-insensitive include mirrors / header symlinks
port/shim/include/
port/shim/caseinclude/
port/shim/RbxG3D
# Keep port/shim/patched (real patched headers) and platform shims tracked.

# --- Runtime caches -----------------------------------------------------------
web/asset-cache/
web/__pycache__/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets ------------------------------------------------------------------
# A .ROBLOSECURITY value is a full account session. Never commit it.
asset-cookie
asset-cookie.txt
*.cookie
.env
.env.*
!.env.example

# --- Local test places at repo root (bundled places live in web/places/) -----
/*.rbxl
/*.rbxlx
/*.rbxm
/*.rbxmx

# --- Logs, screenshots, scratch ----------------------------------------------
*.log
*.trace
*.tmp
*.temp
*.bak
*.orig
*.rej
core.*
/tmp/
scratch/

# --- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Tooling ------------------------------------------------------------------
node_modules/
.pnpm-store/
.venv/
venv/
venv-*/
